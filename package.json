{
  "name": "pr-story-mode",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/providers",
    "packages/cli",
    "packages/extension"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "story": "tsx packages/cli/src/main.ts",
    "build:extension": "npm run build -w @prstory/extension",
    "build:cli": "npm run build -w @prstory/cli"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
